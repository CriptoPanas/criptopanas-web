---
import { siteConfig } from '../data/videos';
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-800 bg-neutral-950 py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center">
    <img src="/logo.svg" alt="Cripto Panas" class="h-16 w-16" />

    <div class="flex gap-5 text-2xl">
      <a href={siteConfig.x} target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-neutral-400 transition-colors hover:text-orange-500">𝕏</a>
      <a href={siteConfig.nostr} target="_blank" rel="noopener noreferrer" aria-label="Nostr" class="text-neutral-400 transition-colors hover:text-orange-500">𝔑</a>
      <a href={siteConfig.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-neutral-400 transition-colors hover:text-orange-500">📷</a>
      <a href={siteConfig.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-neutral-400 transition-colors hover:text-orange-500">▶</a>
    </div>

    <div class="text-sm text-neutral-400 space-y-1">
      <p><a href={`mailto:${siteConfig.email}`} class="hover:text-orange-500">{siteConfig.email}</a></p>
      <p>Telegram: <a href={siteConfig.telegram} target="_blank" rel="noopener noreferrer" class="hover:text-orange-500">@cripto_panas</a></p>
      <p class="break-all max-w-md">Nostr: <a href={siteConfig.nostr} target="_blank" rel="noopener noreferrer" class="hover:text-orange-500">{siteConfig.npub}</a></p>
    </div>

    <p class="text-xs text-neutral-600">© {year} Cripto Panas. Tutoriales de Bitcoin sin tecnicismos.</p>
  </div>
</footer>
