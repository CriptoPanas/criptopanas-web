---
import '../styles/global.css';
import { siteConfig } from '../data/videos';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
}

const { title, description, path = '/', ogImage = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(path, siteConfig.url).toString();
const fullTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Cripto Panas" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteConfig.url).toString()} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteConfig.url).toString()} />
    <meta name="twitter:site" content="@PanasCripto" />

    <!-- JSON-LD Structured Data: Person / Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Cripto Panas",
      "url": siteConfig.url,
      "description": siteConfig.description,
      "sameAs": [
        siteConfig.youtube,
        siteConfig.x,
        siteConfig.instagram,
        siteConfig.nostr,
      ],
    })} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f97316" />
  </head>
  <body class="bg-neutral-950 text-neutral-100 antialiased">
    <slot />
  </body>
</html>
