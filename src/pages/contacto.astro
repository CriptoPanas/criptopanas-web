---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/videos';
---

<Layout
  title="Contacto"
  description="Contacta con Cripto Panas para sugerir un tutorial, resolver dudas sobre tu wallet o solicitar una consultoría personalizada."
  path="/contacto"
>
  <Header />

  <main class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-4xl font-extrabold text-neutral-50">Contacto</h1>
    <p class="mt-4 text-lg text-neutral-300">
      No dudes en escribirme si quieres sugerirme una idea para un tutorial, tienes alguna
      duda o problema con tu wallet y buscas una consulta personalizada, o simplemente deseas
      darme feedback sobre mi trabajo. Estoy a solo un correo de distancia.
    </p>

    <form
      id="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      class="mt-10 space-y-5"
    >
      <input type="hidden" name="access_key" value="TU_ACCESS_KEY_DE_WEB3FORMS" />
      <input type="hidden" name="subject" value="Nuevo mensaje desde criptopanas.com" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-neutral-300">Nombre</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-neutral-100 outline-none focus:border-orange-500"
        />
      </div>

      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-neutral-300">Correo electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-neutral-100 outline-none focus:border-orange-500"
        />
      </div>

      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-neutral-300">Mensaje</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-neutral-100 outline-none focus:border-orange-500"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-orange-500 px-6 py-3 font-semibold text-neutral-950 transition-transform hover:scale-105"
      >
        Enviar mensaje
      </button>

      <p id="form-status" class="text-center text-sm"></p>
    </form>

    <div class="mt-10 border-t border-neutral-800 pt-8 text-center text-sm text-neutral-500">
      <p>
        También puedes escribirme directamente a{' '}
        <a href={`mailto:${siteConfig.email}`} class="text-orange-500 hover:underline">{siteConfig.email}</a>
        {' '}o por Telegram: <a href={siteConfig.telegram} class="text-orange-500 hover:underline">@cripto_panas</a>
      </p>
    </div>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (status) status.textContent = 'Enviando...';
      const formData = new FormData(form);
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        });
        const result = await response.json();
        if (result.success) {
          if (status) {
            status.textContent = '¡Mensaje enviado! Te responderé pronto.';
            status.className = 'text-center text-sm text-green-500';
          }
          form.reset();
        } else {
          if (status) {
            status.textContent = 'Hubo un error. Intenta escribir directamente por correo.';
            status.className = 'text-center text-sm text-red-500';
          }
        }
      } catch {
        if (status) {
          status.textContent = 'Hubo un error. Intenta escribir directamente por correo.';
          status.className = 'text-center text-sm text-red-500';
        }
      }
    });
  </script>
</Layout>
